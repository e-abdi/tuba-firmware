/ {
	chosen {
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
	};

	aliases {
		/* Motors - GPIO control (hyphens in DTS, converted to underscores in C via DT_ALIAS) */
		roll-in-1 = &roll_in_1;
		roll-in-2 = &roll_in_2;
		pitch-in-1 = &pitch_in_1;
		pitch-in-2 = &pitch_in_2;
		pump-in-1 = &pump_in_1;
		pump-in-2 = &pump_in_2;
		i2c0 = &i2c0;
	};
};

/* ===== UART CONFIGURATION ===== */

/* UART0: USB bridge console (TX=GPIO1, RX=GPIO3) - 9600 baud for long cable runs */
&uart0 {
	status = "okay";
	current-speed = <9600>;
};

/* UART1: Avoid using GPIO9/10 (SPI flash pins) */
&uart1 {
	status = "disabled";
};

/* UART2: disabled — GPS is read over I2C (DDC) and the old console-mirror
   code is gone, so it is unused. */
&uart2 {
	status = "disabled";
};

/* ===== I2C CONFIGURATION ===== */
/* I2C0 on GPIO21(SDA)/GPIO22(SCL): main sensor bus
   (MS5837 @0x76, BMP180 @0x77, HMC6343 @0x19, u-blox GPS @0x42) */
&i2c0 {
	status = "okay";
	clock-frequency = <100000>; /* 100kHz */
	ms5837_0: ms5837@76 {
		compatible = "meas,ms5837";
		reg = <0x76>;
		status = "okay";
	};
};

/* I2C1 (the SoC's second HARDWARE I2C controller): left disabled.
   GPIO16/17 (its natural pins) are marked gpio-reserved-ranges in Zephyr's
   own SoC devicetree for this board (alongside 6-11, 20, 24, 28-31) — the
   selected SoC variant assumes a WROVER-E module with PSRAM wired to
   those exact pins. Using them for anything else is a real resource
   conflict, not a timing issue: the GPIO framework itself rejects them
   ("Unsupported pin" assertion) the moment a driver tries to configure
   GPIO16/17 as plain GPIOs. The water-temperature bus below uses
   different, unreserved pins instead. */
&i2c1 {
	status = "disabled";
};

/* Water-temperature bus: software (bit-banged) I2C on GPIO4(SDA)/
   GPIO13(SCL) — free, non-reserved, non-strapping pins — driven as plain
   GPIOs by Zephyr's generic "gpio-i2c" driver rather than the SoC's
   second hardware I2C peripheral (see note above for why i2c1/GPIO16-17
   are off the table). The TSYS01 (Blue Robotics Celsius) lives on its own
   bus because its address (0x77) collides with the BMP180 on i2c0.
   Internal pull-ups are enabled; add external 4.7k pull-ups to 3.3V for
   long/wet cable runs. */
/ {
	i2c_temp: i2c-gpio-temp {
		compatible = "gpio-i2c";
		status = "okay";
		#address-cells = <1>;
		#size-cells = <0>;
		clock-frequency = <100000>; /* 100kHz */
		sda-gpios = <&gpio0 4 (GPIO_OPEN_DRAIN | GPIO_PULL_UP)>;
		scl-gpios = <&gpio0 13 (GPIO_OPEN_DRAIN | GPIO_PULL_UP)>;
	};
};

&gpio0 {
	status = "okay";
};


/* ===== GPIO Motor Control Pins ===== */

/ {
	motor_gpios: motor-gpios {
		compatible = "gpio-leds";

		roll_in_1: roll-in-1 {
			gpios = <&gpio0 25 GPIO_ACTIVE_HIGH>;
		};
		roll_in_2: roll-in-2 {
			gpios = <&gpio0 26 GPIO_ACTIVE_HIGH>;
		};
		pitch_in_1: pitch-in-1 {
			gpios = <&gpio0 27 GPIO_ACTIVE_HIGH>;
		};
		pitch_in_2: pitch-in-2 {
			gpios = <&gpio0 14 GPIO_ACTIVE_HIGH>;
		};
		pump_in_1: pump-in-1 {
			gpios = <&gpio0 18 GPIO_ACTIVE_HIGH>;
		};
		pump_in_2: pump-in-2 {
			gpios = <&gpio0 19 GPIO_ACTIVE_HIGH>;
		};
	};
};

/* ===== WiFi Configuration ===== */

&wifi {
	status = "okay";
};

/* ===== ADC for leak detector ===== */
/* adc0 = ESP32 ADC unit 1 (GPIO32-39); safe with WiFi active.
 * Connect leak sensor signal to GPIO34 (ADC1 CH6). */
&adc0 {
	status = "okay";
};
