/ {
	chosen {
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
	};

	aliases {
		/* Motors - GPIO control (hyphens in DTS, converted to underscores in C via DT_ALIAS) */
		roll-in-1 = &roll_in_1;
		roll-in-2 = &roll_in_2;
		pitch-in-1 = &pitch_in_1;
		pitch-in-2 = &pitch_in_2;
		pump-in-1 = &pump_in_1;
		pump-in-2 = &pump_in_2;
		i2c0 = &i2c0;
	};
};

/* ===== UART CONFIGURATION ===== */

/* UART0: USB bridge console (TX=GPIO1, RX=GPIO3) - 9600 baud for long cable runs */
&uart0 {
	status = "okay";
	current-speed = <9600>;
};

/* UART1: Avoid using GPIO9/10 (SPI flash pins) */
&uart1 {
	status = "disabled";
};

/* UART2: disabled — GPS is read over I2C (DDC) and the old console-mirror
   code is gone, so GPIO16/17 are repurposed as the second I2C bus below. */
&uart2 {
	status = "disabled";
};

/* ===== I2C CONFIGURATION ===== */
/* I2C0 on GPIO21(SDA)/GPIO22(SCL): main sensor bus
   (MS5837 @0x76, BMP180 @0x77, HMC6343 @0x19, u-blox GPS @0x42) */
&i2c0 {
	status = "okay";
	clock-frequency = <100000>; /* 100kHz */
	ms5837_0: ms5837@76 {
		compatible = "meas,ms5837";
		reg = <0x76>;
		status = "okay";
	};
};

/* I2C1 on GPIO16(SDA)/GPIO17(SCL): water-temperature bus.
   The TSYS01 (Blue Robotics Celsius) lives here because its address (0x77)
   collides with the BMP180 on i2c0 — a second bus sidesteps the conflict.
   GPIO16/17 are adjacent on the DevKitC header. Internal pull-ups are
   enabled; add external 4.7k pull-ups to 3.3V for long/wet cable runs. */
&pinctrl {
	i2c1_sensors: i2c1_sensors {
		group1 {
			pinmux = <I2C1_SDA_GPIO16>,
				 <I2C1_SCL_GPIO17>;
			bias-pull-up;
			drive-open-drain;
			output-high;
		};
	};
};

&i2c1 {
	status = "okay";
	clock-frequency = <100000>; /* 100kHz */
	/* sda/scl-gpios are required by the ESP32 I2C driver for bus recovery */
	sda-gpios = <&gpio0 16 GPIO_OPEN_DRAIN>;
	scl-gpios = <&gpio0 17 GPIO_OPEN_DRAIN>;
	pinctrl-0 = <&i2c1_sensors>;
	pinctrl-names = "default";
};

&gpio0 {
	status = "okay";
};


/* ===== GPIO Motor Control Pins ===== */

/ {
	motor_gpios: motor-gpios {
		compatible = "gpio-leds";

		roll_in_1: roll-in-1 {
			gpios = <&gpio0 25 GPIO_ACTIVE_HIGH>;
		};
		roll_in_2: roll-in-2 {
			gpios = <&gpio0 26 GPIO_ACTIVE_HIGH>;
		};
		pitch_in_1: pitch-in-1 {
			gpios = <&gpio0 27 GPIO_ACTIVE_HIGH>;
		};
		pitch_in_2: pitch-in-2 {
			gpios = <&gpio0 14 GPIO_ACTIVE_HIGH>;
		};
		pump_in_1: pump-in-1 {
			gpios = <&gpio0 18 GPIO_ACTIVE_HIGH>;
		};
		pump_in_2: pump-in-2 {
			gpios = <&gpio0 19 GPIO_ACTIVE_HIGH>;
		};
	};
};

/* ===== WiFi Configuration ===== */

&wifi {
	status = "okay";
};

/* ===== ADC for leak detector ===== */
/* adc0 = ESP32 ADC unit 1 (GPIO32-39); safe with WiFi active.
 * Connect leak sensor signal to GPIO34 (ADC1 CH6). */
&adc0 {
	status = "okay";
};
